flowchart LR
    subgraph P["Pilares: o que se propõe"]
        direction TB
        PM["Medicinal<br/>comparticipação SNS,<br/>prescrição simplificada"]
        PR["Recreativo<br/>clubes sociais sem fins lucrativos<br/>+ autocultivo (3 plantas)"]
        PC["Cânhamo industrial<br/>THC &lt; 0,3 %, piloto em 3-5 regiões"]
    end
    subgraph F["Fases: quando e em que ordem"]
        direction TB
        F1["Fase 1 · imediata<br/>cânhamo + revisão medicinal"]
        F2["Fase 2 · após a aprovação da Fase 1<br/>clubes + autocultivo, 18+<br/>(restrições dos 18 aos 20)<br/>avaliação de 2-3 anos"]
        F3["Fase 3 · horizonte condicional<br/>venda comercial regulada<br/>só com dados, UE e nova votação"]
        F1 --> F2 --> F3
    end
    PM --> F1
    PC --> F1
    PR --> F2
    PR -. "só se a Fase 2 provar eficácia" .-> F3

    classDef pilar fill:#e7f0fa,stroke:#1c5d99,color:#10243a
    classDef fase fill:#f4f4f4,stroke:#555,color:#222
    classDef cond fill:#fff6dc,stroke:#a07800,color:#3a2e00,stroke-dasharray:5 3
    class PM,PR,PC pilar
    class F1,F2 fase
    class F3 cond
